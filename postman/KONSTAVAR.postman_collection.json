{
  "info": {
    "_postman_id": "c9f6f9b8-7f31-4da9-b0e1-2f53f5fda001",
    "name": "KONSTAVAR API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "codex"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Create Admin (first time)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Main Admin\",\n  \"phone\": \"+998900000001\",\n  \"password\": \"12345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/create-admin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "create-admin"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set(\"token\", json.token);",
                  "}",
                  "if (json.user && json.user.id) {",
                  "  pm.collectionVariables.set(\"cashierId\", json.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+998900000001\",\n  \"password\": \"12345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get Product by Barcode",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/barcode/{{barcode}}?warehouseId={{warehouseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "barcode",
                "{{barcode}}"
              ],
              "query": [
                {
                  "key": "warehouseId",
                  "value": "{{warehouseId}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Sales",
      "item": [
        {
          "name": "Create Sale (Cash)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"discount\": 0,\n  \"paymentType\": \"cash\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"inputType\": \"unit\",\n      \"inputQuantity\": 2\n    }\n  ],\n  \"note\": \"Cash sale\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sales"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Sale (Card)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"discount\": 0,\n  \"paymentType\": \"card\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"inputType\": \"unit\",\n      \"inputQuantity\": 1\n    }\n  ],\n  \"note\": \"Card sale\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sales"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Sale (Mixed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"discount\": 0,\n  \"paymentType\": \"mixed\",\n  \"cashAmount\": 50000,\n  \"cardAmount\": 30000,\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"inputType\": \"unit\",\n      \"inputQuantity\": 1,\n      \"unitSellPrice\": 80000\n    }\n  ],\n  \"note\": \"Mixed payment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sales"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Sales",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sales?warehouseId={{warehouseId}}&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sales"
              ],
              "query": [
                {
                  "key": "warehouseId",
                  "value": "{{warehouseId}}"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Sale by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sales/{{saleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sales",
                "{{saleId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Sale (Admin only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sales/{{saleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sales",
                "{{saleId}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "warehouseId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "barcode",
      "value": ""
    },
    {
      "key": "saleId",
      "value": ""
    },
    {
      "key": "cashierId",
      "value": ""
    }
  ]
}
